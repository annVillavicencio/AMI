# Configuración de Conexión a Base de Datos SQL Server
# Para Docker Compose (automático): DB_SERVER=sqlserver, DB_PASSWORD=Password123!
# Para desarrollo local directo (node server.js): DB_SERVER=localhost, DB_PASSWORD=123

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=Autos_AMI
DB_USER=sa
DB_PASSWORD=123
DB_WINDOWS_AUTH=false
PORT=3000
