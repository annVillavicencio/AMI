# Configuración para ejecución local directa o con Docker
# Si usas Docker en Windows/Mac, DB_SERVER debe ser: host.docker.internal
# Si corres directamente con 'node server.js', DB_SERVER puede ser: localhost

DB_SERVER=host.docker.internal
DB_PORT=1433
DB_DATABASE=Autos_AMI
DB_USER=sa
DB_PASSWORD=tu_contraseña_aqui
DB_WINDOWS_AUTH=false
PORT=3000
